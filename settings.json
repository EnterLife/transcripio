{
  "ui": {
    "page_title": "Transcripio",
    "page_icon": "T",
    "caption": "Local audio and video transcription with optional local speaker diarization.",
    "upload_types": [
      "mp3",
      "wav",
      "m4a",
      "flac",
      "ogg",
      "aac",
      "mp4",
      "mov",
      "mkv",
      "avi",
      "webm",
      "m4v"
    ]
  },
  "transcription": {
    "whisper_model": "small",
    "whisper_models": [
      "tiny",
      "base",
      "small",
      "medium",
      "large-v3",
      "Systran/faster-whisper-small",
      "mobiuslabsgmbh/faster-whisper-large-v3-turbo"
    ],
    "device": "cpu",
    "compute_type": "int8",
    "language": "",
    "diarization_model_path": "",
    "diarization_repo_id": "pyannote/speaker-diarization-community-1",
    "diarization_output_dir": "models/pyannote-speaker-diarization",
    "ffmpeg_path": "ffmpeg",
    "local_files_only": false,
    "allow_cpu_fallback": true,
    "auto_install_cuda_runtime": true,
    "use_batched_inference": false,
    "batch_size": 8,
    "beam_size": 1,
    "best_of": 1,
    "cpu_threads": 0,
    "num_workers": 1,
    "vad_filter": true,
    "initial_prompt": "",
    "hotwords": "",
    "word_timestamps": false,
    "condition_on_previous_text": true,
    "no_speech_threshold": 0.6,
    "language_detection_threshold": 0.5,
    "hallucination_silence_threshold": ""
  },
  "llm": {
    "default_provider": "LM Studio",
    "providers": [
      {
        "name": "LM Studio",
        "base_url": "http://localhost:1234/v1",
        "model": "local-model",
        "api_key_env": "LM_STUDIO_API_KEY",
        "requires_api_key": false,
        "temperature": 0.2,
        "max_tokens": 1000
      },
      {
        "name": "Yandex AI Studio",
        "base_url": "https://llm.api.cloud.yandex.net/v1",
        "model": "gpt://<folder_id>/yandexgpt/latest",
        "api_key_env": "YANDEX_API_KEY",
        "requires_api_key": true,
        "temperature": 0.2,
        "max_tokens": 1000
      }
    ]
  },
  "storage": {
    "output_dir": "data/output",
    "history_dir": "data/history"
  }
}
